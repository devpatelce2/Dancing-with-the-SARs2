{
  "name": "dancing-with-the-sars",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare:cesium": "node scripts/copy-cesium.mjs",
    "fetch:geo": "node scripts/fetch-geo.mjs",
    "build:geo": "node scripts/build-geo.mjs",
    "index:sites": "node scripts/rebuild-index.mjs",
    "dev": "npm run prepare:cesium && npm run index:sites && vite",
    "build": "npm run prepare:cesium && npm run index:sites && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs test/*.test.mjs",
    "inventory": "node scripts/inventory-datasets.mjs",
    "verify:asf": "node scripts/verify-asf.mjs",
    "verify:live": "python -m pipeline.verify_live"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "cesium": "^1.147.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "vite": "^8.3.8"
  }
}
